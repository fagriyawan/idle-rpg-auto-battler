{
  "name": "idle-rpg-server",
  "version": "1.0.0",
  "description": "Backend service for the idle RPG auto-battler game",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "ts-node src/db/migrate.ts",
    "test": "vitest --run"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "ethers": "6.13.4",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "pg": "8.13.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "nodemon": "3.1.9",
    "ts-node": "10.9.2",
    "typescript": "5.7.3",
    "vitest": "^4.1.7"
  }
}
